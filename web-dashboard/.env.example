# Public, non-secret configuration only. Vite exposes VITE_* to every visitor.
# DemoAirService is deliberately the active service; these URLs document the
# future backend configuration and do not silently enable an incomplete adapter.
VITE_API_BASE_URL=/api/v1
VITE_WEBSOCKET_URL=ws://localhost:3000/api/v1/events
# Never put MQTT, MongoDB, Wi-Fi, or API credentials in this file or VITE_* values.
