# Public, non-secret configuration only. Vite exposes VITE_* to every visitor.
# Copy this file to .env and fill in your Firebase project values locally.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Future backend configuration
VITE_API_BASE_URL=/api/v1
VITE_WEBSOCKET_URL=ws://localhost:3000/api/v1/events
# Never put real API keys, MQTT, MongoDB, or Wi-Fi credentials in this tracked template.
